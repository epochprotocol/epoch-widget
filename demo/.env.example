# Browser-safe allocator route. Caddy proxies this same-origin path to smallocator.
VITE_EPOCH_API_BASE_URL=/allocator
VITE_TESTNET_API_BASE_URL=http://localhost:3000
VITE_TESTNET_POSITIONS_API_BASE_URL=http://localhost:4024

