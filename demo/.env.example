# Local Epoch services. The allocator forwards quotes to local SIO on port 8080,
# which selects the local 1delta adapter. Hosted deployments can use /allocator.
VITE_EPOCH_API_BASE_URL=http://localhost:3000
VITE_TESTNET_API_BASE_URL=http://localhost:3000
VITE_EARN_SOLVER_URL=http://localhost:3011
VITE_POSITIONS_API_BASE_URL=http://localhost:4023
VITE_TESTNET_POSITIONS_API_BASE_URL=http://localhost:4024

# Miden mainnet note transport (also the runtime default).
VITE_MIDEN_NOTE_TRANSPORT_URL=https://transport.cedar.miden.io

# Mainnet defaults come from @epoch-protocol/epoch-flows-sdk. Override only for diagnostics.
# VITE_MIDEN_RPC_URL=https://rpc.cedar.miden.io

# Base uses https://mainnet.base.org without a key. Optional keyed Ankr override:
# VITE_ANKR_API_KEY=

# Optional Infura RPC for all configured EVM chains through the Vite proxy.
# Enabled automatically when INFURA_API_KEY is present. Keep the credential
# in ignored .env.local; do not prefix INFURA_API_KEY with VITE_.
# INFURA_API_KEY=<base64-encoded key:secret>
# Miden uses its own RPC; Robinhood is not supported by this Infura proxy.

# Robinhood uses its own public RPCs, including when Infura is enabled.
# Optional provider overrides:
# VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# VITE_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
