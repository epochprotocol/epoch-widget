+    lenders?: string[];
+    sortBy?: PoolSortBy;
+    sortDir?: PoolSortDir;
+    /** Pagination offset, applied per (chain, lender) pair (not global). */
+    start?: number;
+    /** Per-pair page size. Total rows ≤ `chainIds.length * max(1, lenders.length) * count`. */
+    count?: number;
+    minTvlUsd?: number;
+    maxRiskScore?: number;
+    minUtil?: number;
+    maxUtil?: number;
+    signal?: AbortSignal;
+}
+export interface FetchLendingPoolsPageMultiResult {
+    rows: EarnMarketRow[];
+    hasMore: boolean;
+    failures: {
